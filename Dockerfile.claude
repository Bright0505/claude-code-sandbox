FROM node:24-bookworm-slim

ARG USERNAME=claude
ARG USER_UID=1000
ARG USER_GID=$USER_UID

# System deps:
# - python3/pip: general scripting/tooling support
# - git, gh: version control (glab is installed separately below)
# - iptables/ipset/dnsutils: runtime network allowlist (init-firewall.sh)
# - gosu: drop from root to $USERNAME after firewall setup
# - ripgrep/jq: faster search/JSON handling for Claude Code itself
# - openssh-client: ssh/scp/ssh-keygen binaries only. The firewall allowlists
#   80/443 and blocks port 22 outbound, so this is just the client tooling, not
#   a path for SSH-based git remotes - which is why SSH remotes are rewritten to
#   HTTPS at startup: a port-22 timeout is indistinguishable from a network fault.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        git curl ca-certificates gnupg \
        iptables ipset dnsutils iproute2 \
        ripgrep jq less procps gosu \
        openssh-client \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# node:24 images ship a preexisting uid/gid 1000 ("node"); rename it instead
# of failing on a collision.
RUN if getent group "$USER_GID" >/dev/null; then \
        groupmod -n "$USERNAME" "$(getent group "$USER_GID" | cut -d: -f1)"; \
    else \
        groupadd --gid "$USER_GID" "$USERNAME"; \
    fi \
    && if getent passwd "$USER_UID" >/dev/null; then \
        usermod -l "$USERNAME" -d "/home/$USERNAME" -m "$(getent passwd "$USER_UID" | cut -d: -f1)"; \
    else \
        useradd --uid "$USER_UID" --gid "$USER_GID" -m -s /bin/bash "$USERNAME"; \
    fi

# GitLab CLI. GitLab publishes no apt repo for glab, and the alternative is
# piping their install script into a shell - so take the release .deb with the
# version pinned and the published checksum verified. Its only dependency (git)
# is already installed above, hence dpkg instead of apt.
ARG GLAB_VERSION=1.113.0
RUN arch="$(dpkg --print-architecture)" \
    && base="https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads" \
    && curl -fsSL -o /tmp/glab.deb "$base/glab_${GLAB_VERSION}_linux_${arch}.deb" \
    && curl -fsSL -o /tmp/checksums.txt "$base/checksums.txt" \
    && grep "  glab_${GLAB_VERSION}_linux_${arch}.deb$" /tmp/checksums.txt \
        | sed "s|  glab_.*|  /tmp/glab.deb|" | sha256sum -c - \
    && dpkg -i /tmp/glab.deb \
    && rm -f /tmp/glab.deb /tmp/checksums.txt \
    && glab --version

RUN npm install -g @anthropic-ai/claude-code

# Project-scoped config: this directory is bind-mounted from the host project
# folder (see docker-compose.yml), so login/session state never touches the
# host's global ~/.claude and stays isolated per project.
ENV CLAUDE_CONFIG_DIR=/home/${USERNAME}/.claude
RUN mkdir -p "$CLAUDE_CONFIG_DIR" && chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"

WORKDIR /workspace
RUN chown "$USERNAME:$USERNAME" /workspace

COPY scripts/init-firewall.sh /usr/local/bin/init-firewall.sh
COPY scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY scripts/setup-git-auth.sh /usr/local/bin/setup-git-auth.sh
# git finds a helper named `sandbox-env` by looking for git-credential-sandbox-env
# on PATH, which is why the installed name differs from the source name.
COPY scripts/git-credential-env.sh /usr/local/bin/git-credential-sandbox-env
COPY scripts/git-forge-lib.sh /usr/local/lib/git-forge-lib.sh
RUN chmod +x /usr/local/bin/init-firewall.sh /usr/local/bin/entrypoint.sh \
        /usr/local/bin/setup-git-auth.sh /usr/local/bin/git-credential-sandbox-env

ENTRYPOINT ["entrypoint.sh"]
CMD ["bash"]
